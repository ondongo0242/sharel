{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "hotspot-module": [
        "./modules/hotspot-module"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "modules/**/*.ts"
  ]
}
